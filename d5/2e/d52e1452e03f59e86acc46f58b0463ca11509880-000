# 4 November 2026, 00:15 : dynamic exposure of base colours, Retinex style : reflectance = image / illumination, exposed to the key light of the reference.
# FR : exposition dynamique des base colors, façon Retinex : la réflectance (image divisée par son illumination) exposée à la lumière principale
# de la référence, c'est-à-dire au niveau de ses zones les mieux éclairées. Aucune valeur absolue : la cible se mesure sur la référence.
# Usage : /Users/zenray/.venvs/zenray-uv/bin/python -I BaseColorKeyLight.py <out_dir> <reference.png> <b1.png> <b2.png> [...]
import itertools
import json
import sys

import numpy as np
from PIL import Image, ImageDraw, ImageFont

sys.path.insert(0, "/Users/zenray/.claude/tmp/tmp-zorah-materials-3-november-2026/Scripts")
from BaseColorExposure import to_lin, to_srgb, luminance, gblur, gap, describe  # noqa: E402

P = {"illum_scale": 1 / 8, "key_percentiles": [75, 90, 95]}  # illumination = luminance blurred at 1/8 of the width ; key light = this percentile of it


def key_target(ref, pct, p):
    lin = luminance(to_lin(ref)); w = lin.shape[1]
    illum = np.maximum(gblur(lin, p["illum_scale"] * w), 1e-4)
    reflect = lin / illum
    return float(reflect.mean() * np.percentile(illum, pct)), float(illum.mean())


def expose_lin(rgb, target_lin):
    lin = to_lin(rgb); k = target_lin / max(float(luminance(lin).mean()), 1e-6)
    return to_srgb(lin * k)


def main(out, ref_path, paths):
    ref = np.asarray(Image.open(ref_path).convert("RGB")).astype(np.float64) / 255
    ins = [np.asarray(Image.open(q).convert("RGB")).astype(np.float64) / 255 for q in paths]
    names = [q.split("/")[-1] for q in paths]
    rows, rep = [("entrée", ins)], {"entrée": {"gap": round(float(np.mean([gap(x, y) for x, y in itertools.combinations(ins, 2)])), 2), "means": [describe(a)["mean_srgb"] for a in ins]}}
    for pct in P["key_percentiles"]:
        t, mean_illum = key_target(ref, pct, P)
        outs = [expose_lin(a, t) for a in ins]
        lab = f"lumière principale p{pct} de la référence"
        rows.append((lab, outs))
        rep[lab] = {"target_mean_srgb_derived": round(float(to_srgb(np.array(t)) * 255), 1), "gap": round(float(np.mean([gap(x, y) for x, y in itertools.combinations(outs, 2)])), 2),
                    "means": [describe(o)["mean_srgb"] for o in outs], "outside_pbr_range": [describe(o)["outside_pbr_range"] for o in outs]}
        for n, o in zip(names, outs):
            Image.fromarray((o * 255 + 0.5).astype(np.uint8)).save(f"{out}/key{pct}_{n}")
    rep["reference_mean_srgb"] = describe(ref)["mean_srgb"]
    c = 460
    try:
        font = ImageFont.truetype("/Users/zenray/Library/Fonts/GT-Ultra-Standard-Regular.otf", 18)
    except OSError:
        font = ImageFont.load_default()
    sheet = Image.new("RGB", (len(paths) * (c + 8), len(rows) * (c + 32)), (0, 0, 0))
    for r, (lab, imgs) in enumerate(rows):
        m = rep[lab]
        ImageDraw.Draw(sheet).text((6, r * (c + 32) + 7), f"{lab}   moyennes {' / '.join(str(v) for v in m['means'])} sRGB   écart entre générations {m['gap']}", fill=(255, 255, 255), font=font)
        for i, im in enumerate(imgs):
            sheet.paste(Image.fromarray((im * 255).astype(np.uint8)).resize((c, c)), (i * (c + 8), r * (c + 32) + 32))
    sheet.save(f"{out}/basecolor_keylight_board.png")
    json.dump(rep, open(f"{out}/basecolor_keylight.json", "w"), indent=1, ensure_ascii=False)
    print(json.dumps(rep, indent=1, ensure_ascii=False))


if __name__ == "__main__":
    main(sys.argv[1], sys.argv[2], sys.argv[3:])
