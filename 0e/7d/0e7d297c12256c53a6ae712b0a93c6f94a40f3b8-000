# 4 November 2026, 01:41 : measure the presentation cylinder of a Zorah board and fit a rounded cylinder + pinhole camera to its silhouette.
# FR : mesurer le cylindre de présentation d'une planche Zorah et caler un cylindre arrondi et une caméra sur sa silhouette.
# Usage : /Users/zenray/.venvs/zenray-uv/bin/python -I CylinderSilhouette.py <board.jpg> <out_dir>
import itertools
import json
import sys

import numpy as np
from PIL import Image, ImageDraw
from scipy import ndimage

P = {"left_frac": 0.46, "footer_frac": 0.92, "bg_thresh": 22.0, "cols": 200, "cam_x": 0.0}


def ref_profiles(path, p):
    a = np.asarray(Image.open(path).convert("RGB")).astype(np.float64)
    h, w = a.shape[:2]
    reg = a[: int(h * p["footer_frac"]), : int(w * p["left_frac"])]
    bg = np.median(np.concatenate([reg[:20].reshape(-1, 3), reg[:, :20].reshape(-1, 3)]), 0)
    m = np.linalg.norm(reg - bg, axis=-1) > p["bg_thresh"]
    m = ndimage.binary_opening(m, iterations=2); lab, n = ndimage.label(m)
    m = lab == (np.argmax(np.bincount(lab.ravel())[1:]) + 1); m = ndimage.binary_fill_holes(m)
    ys, xs = np.nonzero(m); x0, x1 = xs.min(), xs.max(); width = x1 - x0
    X = np.linspace(0.02, 0.98, p["cols"]); top, bot = [], []
    for f in X:
        col = m[:, int(x0 + f * width)]; yy = np.nonzero(col)[0]
        top.append(yy.min() / width); bot.append(yy.max() / width)
    top, bot = np.array(top), np.array(bot)
    return {"mask": m, "x0": int(x0), "x1": int(x1), "y0": int(ys.min()), "y1": int(ys.max()), "width_px": int(width),
            "top": top - top.min(), "bot": bot - top.min(), "X": X}


def model_profiles(bevel, hratio, cam_y, dist, p, n_ang=720, n_prof=400, cam_x=0.0):
    # 4 November 2026, 01:44 : cam_x, the sideways offset of the camera in radius units (the board camera is centred between the two objects).
    # radius 1, height = 2 * hratio, bevel in radius units ; camera at (0, cam_y * H/2, dist) looking along -z, no tilt.
    R, H, b = 1.0, 2.0 * hratio, bevel
    c, arc, side = R - b, np.pi * 0.5 * b, H - 2 * b
    s = np.linspace(0, c + 2 * arc + side + c, n_prof); r = np.empty_like(s); y = np.empty_like(s)
    for i, si in enumerate(s):
        if si < c: r[i], y[i] = si, -H / 2
        elif si < c + arc: f = (si - c) / b; r[i], y[i] = c + b * np.sin(f), -H / 2 + b - b * np.cos(f)
        elif si < c + arc + side: r[i], y[i] = R, -H / 2 + b + (si - c - arc)
        elif si < c + 2 * arc + side: f = (si - c - arc - side) / b; r[i], y[i] = c + b * np.cos(f), H / 2 - b + b * np.sin(f)
        else: r[i], y[i] = (2 * c + 2 * arc + side) - si, H / 2
    th = np.linspace(0, 2 * np.pi, n_ang, endpoint=False)
    X = (r[:, None] * np.sin(th)[None, :]).ravel(); Z = (r[:, None] * np.cos(th)[None, :]).ravel(); Y = np.repeat(y, n_ang)
    cy = cam_y * H / 2; zz = dist - Z
    u = (X + cam_x) / zz; v = -(Y - cy) / zz
    u0, u1 = u.min(), u.max(); width = u1 - u0
    bins = np.clip(((u - u0) / width * p["cols"]).astype(int), 0, p["cols"] - 1)
    top = np.full(p["cols"], np.inf); bot = np.full(p["cols"], -np.inf)
    np.minimum.at(top, bins, v / width); np.maximum.at(bot, bins, v / width)
    Xc = (np.arange(p["cols"]) + 0.5) / p["cols"]
    keep = (Xc > 0.02) & (Xc < 0.98)
    t, bo = np.interp(np.linspace(0.02, 0.98, p["cols"]), Xc[keep], top[keep]), np.interp(np.linspace(0.02, 0.98, p["cols"]), Xc[keep], bot[keep])
    return t - t.min(), bo - t.min()


def main(board, out, cam_x=0.0):
    p = dict(P, cam_x=cam_x); ref = ref_profiles(board, p)
    best = None
    for bevel, hratio, cam_y, dist in itertools.product(np.linspace(0.02, 0.4, 20), np.linspace(1.0, 1.45, 19), np.linspace(-0.6, 0.6, 13), [3.0, 4.0, 5.0, 6.5, 8.0, 10.0, 14.0]):
        t, b = model_profiles(bevel, hratio, cam_y, dist, p, n_ang=180, n_prof=160, cam_x=p['cam_x'])
        err = float(np.mean(np.abs(t - ref["top"])) + np.mean(np.abs(b - ref["bot"])))
        if best is None or err < best[0]:
            best = (err, bevel, hratio, cam_y, dist)
    # refine around the best with a finer mesh
    e0, b0, h0, c0, d0 = best
    for bevel, hratio, cam_y, dist in itertools.product(np.linspace(max(0.01, b0 - 0.03), b0 + 0.03, 13), np.linspace(h0 - 0.03, h0 + 0.03, 13), np.linspace(c0 - 0.1, c0 + 0.1, 11), np.linspace(max(2.5, d0 * 0.7), d0 * 1.3, 9)):
        t, b = model_profiles(bevel, hratio, cam_y, dist, p, n_ang=360, n_prof=300, cam_x=p['cam_x'])
        err = float(np.mean(np.abs(t - ref["top"])) + np.mean(np.abs(b - ref["bot"])))
        if err < best[0]:
            best = (err, bevel, hratio, cam_y, dist)
    err, bevel, hratio, cam_y, dist = best
    t, b = model_profiles(bevel, hratio, cam_y, dist, p, cam_x=p['cam_x'])
    rep = {"error_mean_frac_of_width": round(err, 5), "error_px_at_ref_width": round(err * ref["width_px"], 2), "bevel_over_radius": round(float(bevel), 4),
           "height_over_diameter": round(float(hratio), 4), "camera_height_over_half_height": round(float(cam_y), 4), "camera_distance_over_radius": round(float(dist), 3),
           "ref_bbox": [ref["x0"], ref["y0"], ref["x1"], ref["y1"]], "ref_height_over_width": round((ref["y1"] - ref["y0"]) / ref["width_px"], 4)}
    # overlay : reference mask in grey, fitted silhouette edges in red
    W = 800; Hh = int(W * (ref["y1"] - ref["y0"]) / ref["width_px"]) + 40
    im = Image.new("RGB", (W + 40, Hh + 40), (20, 20, 24)); d = ImageDraw.Draw(im)
    m = Image.fromarray((ref["mask"][ref["y0"]:ref["y1"] + 1, ref["x0"]:ref["x1"] + 1] * 140).astype(np.uint8)).resize((W, int(W * (ref["y1"] - ref["y0"] + 1) / (ref["width_px"] + 1))))
    im.paste(Image.merge("RGB", [m, m, m]), (20, 20))
    xs = 20 + ref["X"] * W
    for arr, col in ((t, (255, 60, 40)), (b, (255, 60, 40)), (ref["top"], (60, 200, 255)), (ref["bot"], (60, 200, 255))):
        d.line(list(zip(xs, 20 + arr * W)), fill=col, width=2)
    im.save(f"{out}/silhouette_fit.png")
    json.dump(rep, open(f"{out}/silhouette_fit.json", "w"), indent=1)
    print(json.dumps(rep, indent=1))


if __name__ == "__main__":
    main(sys.argv[1], sys.argv[2], float(sys.argv[3]) if len(sys.argv) > 3 else 0.0)
