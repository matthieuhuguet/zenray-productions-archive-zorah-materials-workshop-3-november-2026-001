def strip_code(md):
    return re.sub(r"`[^`\n]*`", "", re.sub(r"```.*?```", "", md, flags=re.S))


def verify(out=OUT):
    res = []

    def check(name, ok, detail=""):
        res.append({"check": name, "ok": bool(ok), "detail": detail})

    paths = {n: os.path.join(out, n) for n in ("value-chain.svg", "Synthesis.html", "RULE.md", "APPLY.md")}
    for n, p in paths.items():
        check("exists " + n, os.path.isfile(p) and os.path.getsize(p) > 0)
    if not all(r["ok"] for r in res):
        return res
    svg = open(paths["value-chain.svg"], encoding="utf-8").read()
    page = open(paths["Synthesis.html"], encoding="utf-8").read()
    rule = open(paths["RULE.md"], encoding="utf-8").read()
    apply_ = open(paths["APPLY.md"], encoding="utf-8").read()

    # 1. SVG parses. FR : le SVG est du XML valide.
    try:
        import xml.etree.ElementTree as ET
        ET.fromstring(svg.split("?>", 1)[1] if svg.startswith("<?xml") else svg)
        check("svg parses as XML", True)
    except Exception as e:
        check("svg parses as XML", False, str(e))

    # 2. Numbers of the diagram recomputed from JSON. FR : chiffres recalculés.
    try:
        k = key_numbers()
        check("measure JSON files read from " + FILES, True)
    except Exception as e:
        check("measure JSON files read from " + FILES, False, str(e))
        return res
    for name in ("uniformiser_before", "uniformiser_after", "full", "plan_l6", "final"):
        token = re.compile(r"(?<![\d,])%s(?![\d])" % re.escape(k[name]))
        check("svg number %s = %s" % (name, k[name]), token.search(re.sub(r"<style>.*?</style>", "", svg, flags=re.S)), k[name])
    check("html carries the same diagram numbers", all(k[n] in page for n in ("full", "plan_l6", "final")))

    # 3. No external resource. FR : aucune ressource externe.
    allowed_ns = ("http://www.w3.org/2000/svg", "http://www.w3.org/1999/xlink")
    for n, txt in (("Synthesis.html", page), ("value-chain.svg", svg)):
        urls = [u for u in re.findall(r"https?://[^\s\"'<>)]+", txt) if u not in allowed_ns]
        check("no http url in " + n, not urls, ", ".join(urls[:3]))
        refs = re.findall(r"""(?:src|href|xlink:href)\s*=\s*["']([^"']*)["']""", txt) + re.findall(r"url\(\s*['\"]?([^'\")]+)", txt)
        bad = [r for r in refs if not (r.startswith("data:") or r.startswith("#"))]
        check("every src, href and url() is inline in " + n, not bad, ", ".join(b[:60] for b in bad[:3]))
        check("no script, link or import in " + n, not re.search(r"<script|<link|@import|<iframe|<object|<embed", txt, re.I))

    # 4. Fonts and figures embedded. FR : polices et figures embarquées.
    faces = re.findall(r"@font-face\{font-family:'([^']+)';font-style:(\w+)", page)
    check("html embeds GT Ultra, Literata and Literata italic", set(faces) >= {("GT Ultra", "normal"), ("Literata", "normal"), ("Literata", "italic")}, str(faces))
    check("svg embeds GT Ultra and Literata", {f for f, _ in re.findall(r"@font-face\{font-family:'([^']+)';font-style:(\w+)", svg)} >= {"GT Ultra", "Literata"})
    imgs = re.findall(r'<img src="data:image/(?:jpeg|png|webp);base64,', page)
    check("html embeds the 9 handoff figures", len(imgs) == 9, "%d images" % len(imgs))
    check("html under %d MiB" % P["html_limit_mib"], len(page.encode()) < P["html_limit_mib"] * 1024 * 1024, "%d bytes" % len(page.encode()))
    first_h2 = page.find("<h2")
    check("diagram inline before the first section", 0 < page.find('<svg') < first_h2)
    check("inventory and history folded (details closed)", "<details open" not in page and page.count("<details") >= 5)

    # 5. Punctuation : no em dash, en dash or double hyphen used as punctuation. FR : ponctuation.
    def visible(t):
        t = re.sub(r"<style>.*?</style>", "", t, flags=re.S)
        t = re.sub(r"<pre>.*?</pre>|<code[^>]*>.*?</code>", "", t, flags=re.S)
        return html.unescape(re.sub(r"<[^>]+>", " ", t))
    for n, txt in (("Synthesis.html", visible(page)), ("value-chain.svg", visible(svg)), ("RULE.md", rule), ("APPLY.md", strip_code(apply_))):
        bad = re.findall(r".{0,20}(?:—|–| -- |--(?=\s)).{0,20}", txt)
        check("no em dash, en dash or double hyphen in " + n, not bad, " | ".join(bad[:3]))

    # 6. RULE.md : every proposed line dated (3 November 2026). FR : chaque ligne datée.
    blocks = re.findall(r"```(?:markdown|md|text)?\n(.*?)\n```", rule, flags=re.S)
    lines = [l for b in blocks for l in b.splitlines() if l.strip()]
    undated = [l for l in lines if "(3 November 2026)" not in l]
    check("RULE.md proposes text blocks", len(blocks) >= 3, "%d blocks" % len(blocks))
    check("every RULE.md proposed line carries (3 November 2026)", lines and not undated, " | ".join(u[:50] for u in undated[:3]))
    m = re.search(r"\[pointer\]: #\n\n```(?:markdown|md|text)?\n(.*?)\n```", rule, flags=re.S)
    if m:
        add = len((m.group(1) + "\n").encode("utf-8"))
        check("CLAUDE.md stays under %d bytes with the pointer" % P["claude_md_limit"], P["claude_md_bytes"] + add < P["claude_md_limit"],
              "%d + %d = %d" % (P["claude_md_bytes"], add, P["claude_md_bytes"] + add))
    else:
        check("RULE.md marks the CLAUDE.md pointer block", False)

    # 7. APPLY.md names the commands of the brief. FR : APPLY.md porte les commandes.
    for frag in ("Handoff.py pull --branch cloud/zorah-synthesis-3-november-2026", "sync-skill.sh zenray-edit",
                 "/Users/zenray/.claude/tmp/tmp-zorah-materials-3-november-2026/Articles"):
        check("APPLY.md contains " + frag, frag in apply_)

    # 8. No secret. FR : aucun secret.
    secret = re.findall(r"(?i)(?:sk-[a-z0-9]{16,}|ghp_[a-z0-9]{20,}|password\s*[:=]|mot de passe\s*[:=]|486912)", page + svg + rule + apply_)
    check("no secret in the four files", not secret, ", ".join(secret[:3]))
    return res


def report(res, as_json):
    ok = all(r["ok"] for r in res)
    if as_json:
        print(json.dumps({"ok": ok, "checks": res}, ensure_ascii=False, indent=1))
    else:
        for r in res:
            print(("OK   " if r["ok"] else "FAIL ") + r["check"] + (("  [" + r["detail"] + "]") if r["detail"] and not r["ok"] else ""))
        print("VERDICT", "OK" if ok else "FAIL", "%d/%d" % (sum(r["ok"] for r in res), len(res)))
    return 0 if ok else 1


