def fr(x, nd=None):
    """French decimal comma, real minus sign. FR : virgule décimale, vrai signe moins."""
    s = ("%." + str(nd) + "f") % x if nd is not None else repr(x)
    if s.endswith(".0"):
        s = s[:-2]
    return s.replace("-", "−").replace(".", ",")


def mean(v):
    return sum(v) / len(v)


