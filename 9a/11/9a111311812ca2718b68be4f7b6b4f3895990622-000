def build():
    plain = build_svg()
    chars = svg_chars(plain)
    t_data, t_sub = subset_font(os.path.join(FONTS, "GT-Ultra-Regular.woff2"), chars)
    l_data, l_sub = subset_font(os.path.join(FONTS, "Literata-latin.woff2"), chars)
    standalone = build_svg(font_face("GT Ultra", t_data) + font_face("Literata", l_data))
    with open(os.path.join(OUT, "value-chain.svg"), "w", encoding="utf-8") as f:
        f.write('<?xml version="1.0" encoding="UTF-8"?>\n' + standalone + "\n")
    page = build_html(plain)
    with open(os.path.join(OUT, "Synthesis.html"), "w", encoding="utf-8") as f:
        f.write(page)
    print("value-chain.svg %d bytes (fonts subset: %s) ; Synthesis.html %d bytes" % (
        os.path.getsize(os.path.join(OUT, "value-chain.svg")), t_sub and l_sub, os.path.getsize(os.path.join(OUT, "Synthesis.html"))))


