def fenced(rel, index):
    """The n-th ```text block of a Markdown file, verbatim. FR : le n-ième bloc text, mot pour mot."""
    src = open(os.path.join(FILES, rel), encoding="utf-8").read()
    blocks = re.findall(r"```text\n(.*?)\n```", src, flags=re.S)
    return blocks[index]


