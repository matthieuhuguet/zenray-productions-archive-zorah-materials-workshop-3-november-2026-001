NUM_RE = re.compile(
    r"\b\d{1,2} (?:%s) \d{4}(?:, \d{1,2}:\d{2}(?: \+0100)?)?" % "|".join(MONTHS)
    + r"|(?<![\w.,/:])\d{1,2}:\d{2}(?: \+0100)?(?![\w])"
    + r"|(?<![\w.,/-])[−+]?\d+(?:[,.]\d+)?(?: ?%| ?(?:px|min|Mo|Mio|Ko|octets|bits))?(?![\w])"
    + r"|→")


def prose(s):
    """Plain French text with `code` spans -> HTML ; numbers and dates in GT Ultra ; French spaces.
    FR : texte français avec `code` -> HTML ; nombres et dates en GT Ultra ; espaces insécables."""
    parts = re.split(r"(`[^`]*`)", s)
    out = []
    for p in parts:
        if p.startswith("`") and p.endswith("`") and len(p) >= 2:
            out.append("<code>%s</code>" % esc(p[1:-1]))
            continue
        p = p.replace(" :", " :").replace(" ;", " ;").replace("« ", "« ").replace(" »", " »").replace(" ?", " ?").replace(" !", " !")
        e = esc(p)
        out.append(NUM_RE.sub(lambda m: '<span class="num">%s</span>' % re.sub(r" (?=px|min|Mo|Mio|Ko|octets|bits|\+0100)", "\u00a0", m.group(0)), e))
    return "".join(out)


def para(s):
    return "<p>%s</p>" % prose(s)


def table(head, rows, cls=""):
    h = "".join("<th>%s</th>" % prose(c) for c in head)
    b = "".join("<tr>%s</tr>" % "".join("<td>%s</td>" % prose(c) for c in r) for r in rows)
    return '<div class="tw"><table class="%s"><thead><tr>%s</tr></thead><tbody>%s</tbody></table></div>' % (cls, h, b)


def img_data(rel, max_px):
    from PIL import Image
    im = Image.open(os.path.join(FILES, rel)).convert("RGB")
    w0, h0 = im.size
    im.thumbnail((max_px, max_px), Image.LANCZOS)
    b = io.BytesIO(); im.save(b, "JPEG", quality=P["jpeg_quality"], optimize=True, progressive=True)
    return "data:image/jpeg;base64," + base64.b64encode(b.getvalue()).decode(), (w0, h0), im.size


def figure(items, caption):
    """items : list of (rel, alt, max_px). FR : au plus deux images côte à côte."""
    cells = []
    for rel, alt, mx in items:
        uri, (w0, h0), (w, h) = img_data(rel, mx)
        cells.append('<div class="cell"><img src="%s" width="%d" height="%d" alt="%s" loading="lazy" decoding="async"></div>' % (uri, w, h, html.escape(alt), ))
    sizes = []
    for rel, alt, mx in items:
        from PIL import Image
        w0, h0 = Image.open(os.path.join(FILES, rel)).size
        sizes.append("%d × %d px" % (w0, h0))
    cap = caption + " Original : `%s`, %s, réduit pour l'embarquer." % ("`, `".join(os.path.basename(r) for r, _, _ in items), ", ".join(sizes))
    return '<figure class="f%d"><div class="grid">%s</div><figcaption>%s</figcaption></figure>' % (len(items), "".join(cells), prose(cap))


def code_block(text):
