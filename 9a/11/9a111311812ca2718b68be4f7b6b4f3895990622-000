                    % (prose("`%s`" % os.path.basename(fn)), prose(role), ext, esc(ATELIER + "/Articles/" + fn), prose("chemin du dépôt `Projects/zorah-materials/handoff/synthesis-svg-3-November-2026/out/%s`" % fn)))
    head = "".join("<th>%s</th>" % h for h in ["Famille", "Nom", "Rôle", "Type", "Identifiant Assets", "Chemin", "Modification", "Disponibilité", "Secondaire"])
    return total, summary, '<div class="tw"><table class="inv"><thead><tr>%s</tr></thead><tbody>%s</tbody></table></div>' % (head, "".join(rows))


