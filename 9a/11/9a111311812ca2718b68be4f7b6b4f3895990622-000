def esc(s):
    return html.escape(s, quote=False)


def T(x, y, s, cls, size, anchor=None):
    a = ' text-anchor="%s"' % anchor if anchor else ""
    if " b " in " %s " % cls and "<" not in s:
        s = SVG_NUM_RE.sub(lambda m: '<tspan class="t">%s</tspan>' % m.group(0), s)
    return '<text x="%g" y="%g" class="%s" font-size="%g"%s>%s</text>' % (x, y, cls, size, a, s)


SVG_NUM_RE = re.compile(r"(?<![\w.,/-])\d+(?:[,.]\d+)?(?![\w-])")


def arrow_down(x, y1, y2):
