def arrow_right(x1, x2, y):
    return ('<path class="flow" d="M%g %gH%g"/><path class="head" d="M%g %gl-8 -4.5v9z"/>' % (x1, y, x2 - 7, x2, y))


def node(y, h, tag, title, lines, extra=""):
    """A main step : tag, title, description lines. FR : une étape de la chaîne."""
    out = ['<g class="vc-node" data-node="%s">' % esc(title)]
    out.append('<rect class="node" x="%g" y="%g" width="%g" height="%g" rx="6"/>' % (X0, y, MW, h))
    out.append(T(X0 + 18, y + 24, esc(tag), "t acc", 12.5))
    out.append(T(X0 + 18, y + 50, title, "t ink", 19))
    for i, (s, cls, size) in enumerate(lines):
        out.append(T(X0 + 18, y + 74 + i * 24, s, cls, size))
    out.append(extra)
    out.append("</g>")
    return "".join(out)


def chip(x, y, w, h, num, label, desc):
    return ('<g class="vc-node" data-node="%s"><rect class="chip" x="%g" y="%g" width="%g" height="%g" rx="5"/>' % (esc(label), x, y, w, h)
            + T(x + 14, y + 44, num, "t acc", 24)
            + T(x + 42, y + 28, esc(label), "t ink", 14)
            + T(x + 42, y + 50, esc(desc), "b mut", 13) + "</g>")


def off_box(y, h, time, title, lines, link_y):
