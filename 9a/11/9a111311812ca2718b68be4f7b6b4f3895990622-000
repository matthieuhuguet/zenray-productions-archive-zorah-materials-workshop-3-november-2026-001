def manifest():
    m = {}
    for d in (HANDOFF, FONTS_HANDOFF):
        mm = json.load(open(os.path.join(d, "MANIFEST.json"), encoding="utf-8"))
        for f in mm["files"]:
            f = dict(f); f["_dir"] = d
            m[f["key"]] = f
    return m


def inventory_html():
    m = manifest()
    fams = [(name, [(m[k], role) for k, role in items]) for name, items in FAMILIES]
    font_items = [(m[k], "police embarquée en base64") for k in m if k.endswith(".woff2")]
    fams.append(("Polices", font_items))
    outs = [("value-chain.svg", "diagramme de la chaîne, autonome"), ("Synthesis.html", "cette synthèse"),
            ("RULE.md", "textes exacts de la règle SVG"), ("APPLY.md", "gestes locaux ordonnés"),
            ("build/BuildSynthesis.py", "générateur et vérificateur de ces sorties")]
    total = sum(len(i) for _, i in fams) + len(outs)
    summary = " · ".join("%s %d" % (n, len(i)) for n, i in fams) + " · Sorties %d" % len(outs)
    rows = []
    for name, items in fams:
        for f, role in items:
            ext = os.path.splitext(f["key"])[1].lstrip(".").upper()
            sec = "%s octets · sha256 `%s` · blob `%s` · copié dans `%s`" % (f"{f['bytes']:,}".replace(",", " "), f["sha256"], f["blob"], f["repo_path"])
            rows.append("<tr><td>%s</td><td>%s</td><td>%s, confirmé par le handoff</td><td>%s</td><td>non fourni</td><td><code class=\"path\">%s</code></td><td>non mesurée</td>"
                        "<td>Mac : source déclarée · GitHub main : sha256 vérifié · Assets : non vérifié</td><td><details><summary>détails</summary>%s</details></td></tr>"
                        % (esc(name), prose("`%s`" % os.path.basename(f["key"])), prose(role), ext, esc(f["source"]), prose(sec)))
    for fn, role in outs:
        ext = os.path.splitext(fn)[1].lstrip(".").upper()
        rows.append("<tr><td>Sorties</td><td>%s</td><td>%s</td><td>%s</td><td>non fourni</td><td><code class=\"path\">%s</code></td><td>non mesurée</td>"
