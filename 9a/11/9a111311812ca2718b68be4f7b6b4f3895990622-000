    cx, cy = SX + SW - 20, y + 18
    out.append('<path class="x" d="M%g %gl8 8M%g %gl-8 8"/>' % (cx - 4, cy - 4, cx + 4, cy - 4))
    out.append(T(SX + 14, y + 22, time, "t mut", 12.5))
    out.append(T(SX + 14, y + 44, esc(title), "t ink", 14.5))
    for i, s in enumerate(lines):
        out.append(T(SX + 14, y + 64 + i * 18, esc(s), "b mut", 12.5))
    out.append("</g>")
    out.append('<path class="link" d="M%g %gH%g"/><circle cx="%g" cy="%g" r="3" class="head"/>' % (SX, link_y, X0 + MW, X0 + MW, link_y))
