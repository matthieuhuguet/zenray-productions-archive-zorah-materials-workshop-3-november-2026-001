def svg_chars(svg):
    txt = re.sub(r"<[^>]+>", " ", re.sub(r"<style>.*?</style>", "", svg, flags=re.S))
    return set(html.unescape(txt)) | set(" 0123456789,.")


def subset_font(path, chars):
    """Woff2 subset when fontTools is there, else the whole font. FR : sous-ensemble si fontTools est installé."""
    try:
        from fontTools import subset
        from fontTools.ttLib import TTFont
        f = TTFont(path)
        opts = subset.Options(); opts.flavor = "woff2"; opts.layout_features = ["*"]
        sb = subset.Subsetter(options=opts); sb.populate(text="".join(sorted(chars))); sb.subset(f)
        b = io.BytesIO(); f.flavor = "woff2"; f.save(b)
        return b.getvalue(), True
    except Exception:
        return open(path, "rb").read(), False


def font_face(family, data, style="normal"):
    return ("@font-face{font-family:'%s';font-style:%s;font-weight:400;font-display:block;src:url(data:font/woff2;base64,%s) format('woff2')}"
            % (family, style, base64.b64encode(data).decode()))


