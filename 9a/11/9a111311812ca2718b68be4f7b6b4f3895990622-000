    breaks = {
        "external font": ("Synthesis.html", lambda t: t.replace("</style>", "@font-face{font-family:x;src:url(https://example.com/x.woff2)}</style>", 1)),
        "em dash": ("Synthesis.html", lambda t: t.replace("<p>", "<p>avant — après ", 1)),
        "drifted number": ("value-chain.svg", lambda t: t.replace(key_numbers()["final"], "0,9999")),
        "undated rule line": ("RULE.md", lambda t: t.replace(" (3 November 2026)\n```", "\n```", 1)),
        "missing figure": ("Synthesis.html", lambda t: re.sub(r'<img src="data:image/jpeg;base64,[^"]+"', '<img src=""', t, count=1)),
    }
    reds = {}
    for name, (fn, mutate) in breaks.items():
        tmp = tempfile.mkdtemp()
        for n in ("value-chain.svg", "Synthesis.html", "RULE.md", "APPLY.md"):
            shutil.copy(os.path.join(OUT, n), tmp)
        p = os.path.join(tmp, fn)
        t = open(p, encoding="utf-8").read(); open(p, "w", encoding="utf-8").write(mutate(t))
        reds[name] = not all(r["ok"] for r in verify(tmp))
        shutil.rmtree(tmp)
    ok = good and all(reds.values())
    print(json.dumps({"green_on_real": good, "red_on_broken": reds, "ok": ok}, ensure_ascii=False))
    return 0 if ok else 1


if __name__ == "__main__":
    ap = argparse.ArgumentParser()
    ap.add_argument("cmd", choices=["build", "verify", "selftest"])
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()
    if a.cmd == "build":
        build()
    elif a.cmd == "verify":
        sys.exit(report(verify(), a.json))
    else:
        sys.exit(selftest())
