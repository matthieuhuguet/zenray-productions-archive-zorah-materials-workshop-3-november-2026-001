        for j, cell in enumerate(cells): board.paste(cell.convert("RGB").resize((c, c), Image.NEAREST if j in (2, 3) else Image.LANCZOS), (lab + j * c, y))
        put_text(dr, (6, y + 6), name, fill=(235, 235, 235))
