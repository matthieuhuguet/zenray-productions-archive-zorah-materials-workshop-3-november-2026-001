        put_text(dr, (6, y + 42), f"clair+ombre {m['paired']:.2f}", fill=(200, 200, 200))
        put_text(dr, (6, y + 58), f"cohérence {m['coherence']:.2f}", fill=(200, 200, 200))
        put_text(dr, (6, y + 74), f"asym. {m['skew_highpass']:+.2f}", fill=(200, 200, 200))
        if "cone_corr" in m:
            put_text(dr, (6, y + 90), f"cône studio {m['cone_corr']:+.2f}", fill=(200, 200, 200))
    board.save(OUT / "board.png")
    (OUT / "metrics.json").write_text(json.dumps(report, indent=2), encoding="utf-8")
    keys = ["bright_share", "paired", "coherence", "light_from_deg", "skew_highpass", "highlights", "shadows",
            "lf_ratio", "cone_corr", "plane_gradient", "mean", "std", "p1", "p99", "spectrum_slope",
            "seam_ratio_lr", "seam_ratio_tb", "native_hf_share"]
    allrows = {**report["images"], **report["calibration"]}
    print("metric".ljust(22) + "".join(k[:16].rjust(17) for k in allrows))
    for k in keys:
        vals = []
        for v in allrows.values():
            x = v.get(k, "")
            vals.append((f"{x:.3f}" if isinstance(x, float) else str(x)).rjust(17))
        print(k.ljust(22) + "".join(vals))
    print("board", OUT / "board.png")


if __name__ == "__main__":
