# 3 November 2026, 23:49 : test bench, harmonise several ChatGPT base colours of one surface (colour, brightness, saturation, broad light).
# FR : banc d'essai, harmoniser plusieurs base colors ChatGPT d'une même surface (couleur, luminosité, saturation, lumière large).
# Variants : V1 Reinhard colour transfer in Lab towards the mean of the inputs ; V2 flat field on L then V1 ; V3 flat field then
# histogram matching on a shared target ; V4 rolling ball from above on L then V1 (the step 4 of the base colour prompt).
# Usage : /Users/zenray/.venvs/zenray-uv/bin/python -I HarmoniseBaseColor.py <out_dir> <a1.png> <a2.png> [...]
import itertools
import json
import sys

import numpy as np
from PIL import Image, ImageDraw, ImageFont
from skimage import color, exposure, restoration, transform

P = {"flat_scale": 1 / 4, "rb_radius": 1 / 32, "detail_px": 8 / 2048}  # fractions of the width


def load(p):
    return np.asarray(Image.open(p).convert("RGB")).astype(np.float64) / 255.0


def gblur(a, s):
    fy = np.fft.fftfreq(a.shape[0])[:, None]; fx = np.fft.rfftfreq(a.shape[1])[None, :]
    return np.fft.irfft2(np.fft.rfft2(a) * np.exp(-2 * np.pi ** 2 * s ** 2 * (fx ** 2 + fy ** 2)), s=a.shape)


def lab(rgb):
    return color.rgb2lab(np.clip(rgb, 0, 1))


def rgb(l):
    return np.clip(color.lab2rgb(l), 0, 1)


def reinhard(L, target):
    out = L.copy()
    for c in range(3):
        m, s = L[..., c].mean(), L[..., c].std()
        out[..., c] = (L[..., c] - m) / max(s, 1e-6) * target[1][c] + target[0][c]
    return out


def flat_field(L, p):
    # Light is multiplicative on the albedo : divide L by its very broad blur, keep the mean.
    w = L.shape[1]; out = L.copy()
    lo = gblur(L[..., 0], p["flat_scale"] * w)
    out[..., 0] = L[..., 0] / np.maximum(lo, 1e-3) * lo.mean()
    return out


def rolling_top_L(L, p):
    w = L.shape[1]; l0 = L[..., 0] / 100.0
    small = transform.rescale(l0, 0.25, anti_aliasing=True)
    bg = 1.0 - restoration.rolling_ball(1.0 - small, radius=max(1.0, p["rb_radius"] * w * 0.25))
    bg = gblur(transform.resize(bg, l0.shape, order=3), w / 64)
    out = L.copy(); out[..., 0] = (l0 - bg + bg.mean()) * 100.0
    return out


def light_slope(L):
    # Broad light left : range of the best plane fitted to L, in L units (0 to 100).
    h, w = L.shape[:2]; yy, xx = np.mgrid[0:h, 0:w]
    A = np.stack([xx.ravel() / w, yy.ravel() / h, np.ones(h * w)], 1)
    c, *_ = np.linalg.lstsq(A, L[..., 0].ravel(), rcond=None)
    return float(abs(c[0]) + abs(c[1]))


def corr(a, b):
    a = a - a.mean(); b = b - b.mean()
    return float((a * b).sum() / np.sqrt((a * a).sum() * (b * b).sum()))


def main(out_dir, paths):
    ins = [lab(load(p)) for p in paths]
    names = [p.split("/")[-1] for p in paths]
    target = (np.mean([L.reshape(-1, 3).mean(0) for L in ins], 0), np.mean([L.reshape(-1, 3).std(0) for L in ins], 0))
    shared = np.concatenate([L.reshape(-1, 3) for L in ins], 0)[::7].reshape(-1, 1, 3)
    variants = {
        "V0 entrée": lambda L: L,
        "V1 transfert Reinhard (Lab)": lambda L: reinhard(L, target),
        "V2 champ plat + Reinhard": lambda L: reinhard(flat_field(L, P), target),
        "V3 champ plat + histogramme commun": lambda L: exposure.match_histograms(flat_field(L, P), shared, channel_axis=-1),
        "V4 rolling ball haut sur L + Reinhard": lambda L: reinhard(rolling_top_L(L, P), target),
    }
    rep, rows = {}, []
    for vn, f in variants.items():
        outs = [f(L) for L in ins]
        means = [o.reshape(-1, 3).mean(0) for o in outs]
        dE = max(float(np.linalg.norm(a - b)) for a, b in itertools.combinations(means, 2))
        w = outs[0].shape[1]
        # 3 November 2026, 23:51 : similarity per channel (a stacked Lab correlation is inflated by the channel offsets) and local colour gap.
        sim = float(np.mean([np.mean([corr(x[..., c], y[..., c]) for c in range(3)]) for x, y in itertools.combinations(outs, 2)]))
        gap = float(np.mean([np.linalg.norm(np.stack([gblur(x[..., c], w / 128) - gblur(y[..., c], w / 128) for c in range(3)], -1), axis=-1).mean() for x, y in itertools.combinations(outs, 2)]))
        blocks = float(np.mean([corr(gblur(o[..., 0], w / 128) - gblur(o[..., 0], w / 8), gblur(L[..., 0], w / 128) - gblur(L[..., 0], w / 8)) for o, L in zip(outs, ins)]))
        det = float(np.mean([corr(o[..., 0] - gblur(o[..., 0], P["detail_px"] * w), L[..., 0] - gblur(L[..., 0], P["detail_px"] * w)) for o, L in zip(outs, ins)]))
        rep[vn] = {"delta_E_max_between_means": round(dE, 2), "local_colour_gap_dE": round(gap, 2), "block_variation_kept": round(blocks, 4), "similarity": round(sim, 4), "light_slope": [round(light_slope(o), 2) for o in outs], "detail_kept": round(det, 4)}
        print(vn, rep[vn], flush=True)
        rows.append((vn, [rgb(o) for o in outs]))
        for n, o in zip(names, outs):
            Image.fromarray((rgb(o) * 255 + 0.5).astype(np.uint8)).save(f"{out_dir}/{vn.split()[0]}_{n}")
    c = 420
    try:
        font = ImageFont.truetype("/Users/zenray/Library/Fonts/GT-Ultra-Standard-Regular.otf", 17)
    except OSError:
        font = ImageFont.load_default()
    sheet = Image.new("RGB", (len(paths) * (c + 8), len(rows) * (c + 30)), (0, 0, 0))
    for r, (vn, imgs) in enumerate(rows):
        m = rep[vn]
        for i, im in enumerate(imgs):
            sheet.paste(Image.fromarray((im * 255).astype(np.uint8)).resize((c, c)), (i * (c + 8), r * (c + 30) + 30))
        ImageDraw.Draw(sheet).text((6, r * (c + 30) + 6), f"{vn}   écart local {m['local_colour_gap_dE']} dE   ressemblance {m['similarity']}   pente de lumière {max(m['light_slope'])}   blocs gardés {m['block_variation_kept']}", fill=(255, 255, 255), font=font)
    sheet.save(f"{out_dir}/basecolor_harmonise_board.png")
    json.dump(rep, open(f"{out_dir}/basecolor_harmonise.json", "w"), indent=1, ensure_ascii=False)


if __name__ == "__main__":
    main(sys.argv[1], sys.argv[2:])
