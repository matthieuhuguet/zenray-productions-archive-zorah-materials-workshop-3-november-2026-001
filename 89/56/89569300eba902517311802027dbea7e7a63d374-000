<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Zorah Project Study, credit band</title>
<style>
@font-face {
  font-family: 'GT Ultra';
  src: url(data:font/woff2;base64,) format('woff2');
  font-weight: 400;
  font-style: normal;
  font-display: block;
}
:root {
  --band-bg: #000000;
  --band-h: 3.984cqw;
  --pad-x: 5cqw;
  --mark-h: 2cqw;
  --type-size: 1.45cqw;
  --gap: 0.9cqw;
  --slash-gap: 0.7cqw;
  --logo-grey: #d0d0d0;
  --text-grey: #9a9a9a;
}
html, body { margin: 0; background: var(--band-bg); }
.page { container-type: inline-size; width: 100%; }
.band {
  box-sizing: border-box;
  height: var(--band-h);
  padding: 0 var(--pad-x);
  background: var(--band-bg);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-family: 'GT Ultra', sans-serif;
  font-weight: 400;
  font-size: var(--type-size);
  line-height: 1;
  white-space: nowrap;
  color: var(--text-grey);
}
.left, .right { display: flex; align-items: center; }
.mark { width: var(--mark-h); height: var(--mark-h); display: block; }
.mark rect { fill: var(--band-bg); }
.mark .cls-1 { fill: var(--logo-grey); }
.wordmark { color: var(--logo-grey); text-transform: uppercase; letter-spacing: 0.02em; margin-left: var(--gap); }
.sep { margin: 0 var(--slash-gap); }
.author, .project { color: var(--text-grey); }
</style>
</head>
<body>
<div class="page">
  <footer class="band">
    <div class="left">
      <svg class="mark" role="img" aria-label="ZenRay" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024"><g id="Layer_2" data-name="Layer 2"><g id="Layer_1-2" data-name="Layer 1"><rect width="1024" height="1024" rx="100"/><path class="cls-1" d="M239.39,558.61h0A244.75,244.75,0,0,1,430.7,466.52H784.26L926.19,278.14,242.31,276.6a244.71,244.71,0,0,1-120.7-32.15L75.5,218.16Z"/><path class="cls-1" d="M784.61,466.39h0A244.75,244.75,0,0,1,593.3,558.48H239.74L97.81,746.86l683.88,1.54a244.71,244.71,0,0,1,120.7,32.15l46.11,26.29Z"/></g></g></svg>
      <span class="wordmark">ZenRay</span>
      <span class="sep">|</span>
      <span class="author">Matthieu Huguet</span>
    </div>
    <div class="right">
      <span class="project">Zorah Project Study</span>
    </div>
  </footer>
</div>
</body>
</html>
